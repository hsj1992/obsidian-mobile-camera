{
	"name": "mobile-camera",
	"version": "1.0.0",
	"description": "A third-party Obsidian plugin that lets you take photos and capture QR codes on mobile devices, then insert them into notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"lint": "eslint src",
		"validate:release": "node scripts/validate-release.mjs",
		"test:release": "node --test scripts/validate-release.test.mjs",
		"check": "npm run validate:release && npm run lint && npm test -- --runInBand && npm run test:release && npm run build",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"mobile",
		"android",
		"camera",
		"qr"
	],
	"author": "hsj1992",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@jest/environment-jsdom-abstract": "^30.5.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^18.0.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.27.1",
		"eslint": "^10.10.0",
		"globals": "^17.12.0",
		"jest": "^30.5.1",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"ts-jest": "^29.4.12",
		"tslib": "2.4.0",
		"typescript": "^5.3.0",
		"typescript-eslint": "^8.70.0"
	},
	"dependencies": {
		"jsqr": "^1.4.0"
	}
}
